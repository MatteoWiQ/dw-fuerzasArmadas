{
	"name": "MovimientoPersonalaSilver",
	"properties": {
		"folder": {
			"name": "Bronze-Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_movimientos_personal_bronze",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_csv_generico",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_movimiento as string,",
				"          id_efectivo as string,",
				"          id_unidad_destino as string,",
				"          id_rango as string,",
				"          id_tipo as string,",
				"          fecha_movimiento as string,",
				"          antiguedad_anios as string,",
				"          salario_mensual as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     multiLineRow: true) ~> source1",
				"source1 derive(fecha_movimiento = case(     rlike(fecha_movimiento, '^\\\\d{4}/\\\\d{2}/\\\\d{2}$'), toDate(fecha_movimiento, 'yyyy/MM/dd'),     rlike(fecha_movimiento, '^\\\\d{4}-\\\\d{2}-\\\\d{2}$'), toDate(fecha_movimiento, 'yyyy-MM-dd'),     rlike(fecha_movimiento, '^\\\\d{8}$'), toDate(fecha_movimiento, 'yyyyMMdd'),     rlike(fecha_movimiento, '^\\\\d{2}/\\\\d{2}/\\\\d{4}$'), toDate(fecha_movimiento, 'dd/MM/yyyy'),     rlike(fecha_movimiento, '^\\\\d{2}-\\\\d{2}-\\\\d{4}$') && toInteger(split(fecha_movimiento, '-')[1]) > 12, toDate(fecha_movimiento, 'dd-MM-yyyy'),     rlike(fecha_movimiento, '^\\\\d{2}-\\\\d{2}-\\\\d{4}$') && toInteger(split(fecha_movimiento, '-')[2]) > 12, toDate(fecha_movimiento, 'MM-dd-yyyy'),     rlike(fecha_movimiento, '^\\\\d{2}-\\\\d{2}-\\\\d{4}$'), toDate(fecha_movimiento, 'dd-MM-yyyy'),     toDate(null()) ),",
				"          antiguedad_anios = case(\r",
				"    isNull(antiguedad_anios), toDecimal(null(), 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'veinticinco') > 0, toDecimal(25.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'veinticuatro') > 0, toDecimal(24.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'veintitrés') > 0, toDecimal(23.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'veintidós') > 0, toDecimal(22.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'veintiuno') > 0, toDecimal(21.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'veinte') > 0, toDecimal(20.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'diecinueve') > 0, toDecimal(19.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'diecocho') > 0, toDecimal(18.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'diecisiete') > 0, toDecimal(17.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'dieciséis') > 0, toDecimal(16.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'quince') > 0, toDecimal(15.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'catorce') > 0, toDecimal(14.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'trece') > 0, toDecimal(13.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'doce') > 0, toDecimal(12.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'once') > 0, toDecimal(11.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'diez') > 0, toDecimal(10.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'nueve') > 0, toDecimal(9.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'ocho') > 0, toDecimal(8.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'siete') > 0, toDecimal(7.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'seis') > 0, toDecimal(6.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'cinco') > 0, toDecimal(5.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'cuatro') > 0, toDecimal(4.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'tres') > 0, toDecimal(3.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'dos') > 0, toDecimal(2.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'uno') > 0, toDecimal(1.0, 4, 1),\r",
				"    instr(lower(antiguedad_anios), 'cero') > 0, toDecimal(0.0, 4, 1),\r",
				"    toDecimal(regexExtract(replace(antiguedad_anios, ',', '.'), '([0-9]+\\\\.?[0-9]*)', 1), 4, 1)\r",
				"),",
				"          salario_mensual = case(     rlike(regexReplace(salario_mensual, '[^0-9\\\\.,]', ''), ',\\\\d{2}$'),      toDecimal(replace(replace(regexReplace(salario_mensual, '[^0-9\\\\.,]', ''), '.', ''), ',', '.'), 10, 2),     toDecimal(replace(regexReplace(salario_mensual, '[^0-9\\\\.,]', ''), ',', ''), 10, 2) ),",
				"          observaciones = case(     isNull(observaciones) || rlike(lower(trim(observaciones)), '^(s/n|n/a|sin obs\\\\.?|sin observaciones|| )$'), toString(null()),     true(), initCap(regexReplace(regexReplace(observaciones, '(?i)^Ref:\\\\s*', ''), '[\\\\n\\\\r\\\\s]+', ' ')) ),",
				"          id_movimiento = toInteger(id_movimiento),",
				"          id_efectivo = toInteger(id_efectivo),",
				"          id_unidad_destino = toInteger(id_unidad_destino),",
				"          id_rango = toInteger(id_rango),",
				"          id_tipo = toInteger(id_tipo)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['movimiento_personal_limpio.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}