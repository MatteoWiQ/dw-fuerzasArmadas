{
	"name": "2ReporteOperaciones",
	"properties": {
		"folder": {
			"name": "Silver-Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_gold_sql_operaciones",
						"type": "DatasetReference"
					},
					"name": "Operaciones"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_sql_tipo_operacion",
						"type": "DatasetReference"
					},
					"name": "tipoOperaciones"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_reporte_costo_operaciones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_operacion as integer,",
				"          id_tipo as integer,",
				"          id_unidad_resp as integer,",
				"          id_zona as integer,",
				"          nombre_operacion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          efectivos_desplegados as integer,",
				"          vehiculos_utilizados as integer,",
				"          duracion_dias as integer,",
				"          costo_operacion as decimal(12,2),",
				"          resultado as string,",
				"          detenidos as integer,",
				"          area_km2 as decimal(10,2),",
				"          incidentes as integer,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Operaciones",
				"source(output(",
				"          id_tipo as integer,",
				"          nombre as string,",
				"          categoria as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> tipoOperaciones",
				"Operaciones, tipoOperaciones join(Operaciones@id_tipo == tipoOperaciones@id_tipo,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 filter(nombre == 'Antinarcóticos' || lower(categoria) == 'defensa_civil') ~> filter1",
				"filter1 derive(grupo_operacion = iif(nombre == 'Antinarcóticos', 'Antinarcóticos', 'Defensa Civil')) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(grupo_operacion),",
				"     costo_promedio = avg(costo_operacion),",
				"          cantidad_operaciones = count(id_operacion)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          categoria as string,",
				"          cantidad_operaciones as integer,",
				"          costo_promedio as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}