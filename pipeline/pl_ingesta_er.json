			{
				"name": "Script1",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "sqlGold",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "-- ======================================================================\n-- FASE 1: LIMPIEZA DE TABLAS (DROP)\n-- Orden correcto: Primero Hechos y Reportes, luego Dimensiones.\n-- ======================================================================\n\n-- 1.1 Borrar Reportes\nDROP TABLE IF EXISTS dbo.rep_traslados_departamento;\nDROP TABLE IF EXISTS dbo.rep_costos_operaciones;\nDROP TABLE IF EXISTS dbo.rep_operaciones_por_mes;\nDROP TABLE IF EXISTS dbo.rep_rotacion_unidades;\n\n-- 1.2 Borrar Hechos\nDROP TABLE IF EXISTS dbo.fact_movimientos_personal;\nDROP TABLE IF EXISTS dbo.fact_operaciones;\n\n-- 1.3 Borrar Dimensiones\nDROP TABLE IF EXISTS dbo.dim_zonas;\nDROP TABLE IF EXISTS dbo.dim_unidades;\nDROP TABLE IF EXISTS dbo.dim_tipo_operacion;\nDROP TABLE IF EXISTS dbo.dim_tipo_movimiento;\nDROP TABLE IF EXISTS dbo.dim_efectivos;\n\n-- ======================================================================\n-- FASE 2: CREACIÓN DE DIMENSIONES (Catálogos Base)\n-- ======================================================================\n\nCREATE TABLE dbo.dim_zonas (\n    id_zona INT PRIMARY KEY,\n    nombre VARCHAR(150) NOT NULL,\n    departamento VARCHAR(100) NOT NULL,\n    frontera_con VARCHAR(100) NULL,\n    tipo_terreno VARCHAR(100) NULL,\n    altitud_msnm INT NULL,\n    nivel_riesgo VARCHAR(50) NULL,\n    acceso_carretero BIT NULL\n);\n\nCREATE TABLE dbo.dim_unidades (\n    id_unidad INT PRIMARY KEY,\n    id_brigada INT NULL,\n    nombre VARCHAR(150) NOT NULL,\n    codigo VARCHAR(50) NULL,\n    ciudad VARCHAR(100) NULL,\n    departamento VARCHAR(100) NULL,\n    tipo_cuartel VARCHAR(50) NULL\n);\n\nCREATE TABLE dbo.dim_tipo_operacion (\n    id_tipo INT PRIMARY KEY,\n    nombre VARCHAR(150) NOT NULL,\n    categoria VARCHAR(100) NOT NULL\n);\n\nCREATE TABLE dbo.dim_tipo_movimiento (\n    id_tipo INT PRIMARY KEY,\n    nombre VARCHAR(100) NOT NULL,\n    descripcion VARCHAR(250) NULL\n);\n\nCREATE TABLE dbo.dim_efectivos (\n    id_efectivo INT PRIMARY KEY,\n    id_especialidad INT NULL,\n    id_unidad_actual INT NULL,\n    id_rango_actual INT NULL,\n    nombre VARCHAR(200) NOT NULL,\n    ci VARCHAR(50) NULL,\n    fecha_nacimiento DATE NULL,\n    genero VARCHAR(20) NULL,\n    departamento_origen VARCHAR(100) NULL,\n    fecha_ingreso DATE NULL,\n    estado VARCHAR(50) NULL,\n    salario_mensual DECIMAL(12,2) NULL\n);\n\n-- ======================================================================\n-- FASE 3: CREACIÓN DE TABLAS DE HECHOS (Transacciones)\n-- ======================================================================\n\nCREATE TABLE dbo.fact_movimientos_personal (\n    id_movimiento INT PRIMARY KEY,\n    id_efectivo INT NULL,\n    id_unidad_destino INT NULL,\n    id_rango INT NULL,\n    id_tipo INT NULL,\n    fecha_movimiento DATE NULL,\n    antiguedad_anios DECIMAL(5,2) NULL,\n    salario_mensual DECIMAL(12,2) NULL,\n    observaciones VARCHAR(500) NULL\n);\n\nCREATE TABLE dbo.fact_operaciones (\n    id_operacion INT PRIMARY KEY,\n    id_tipo INT NULL,\n    id_unidad_resp INT NULL,\n    id_zona INT NULL,\n    nombre_operacion VARCHAR(200) NULL,\n    fecha_inicio DATE NULL,\n    fecha_fin DATE NULL,\n    efectivos_desplegados INT NULL,\n    vehiculos_utilizados INT NULL,\n    duracion_dias INT NULL,\n    costo_operacion DECIMAL(12,2) NULL,\n    resultado VARCHAR(50) NULL,\n    detenidos INT NULL,\n    area_km2 DECIMAL(10,2) NULL,\n    incidentes INT NULL,\n    observaciones VARCHAR(500) NULL\n);\n\n-- ======================================================================\n-- FASE 4: CREACIÓN DE DATA MARTS (Tablas de Reporte / Destinos Gold)\n-- ======================================================================\n\nCREATE TABLE dbo.rep_traslados_departamento (\n    departamento VARCHAR(100) PRIMARY KEY,\n    total_traslados INT NOT NULL\n);\n\nCREATE TABLE dbo.rep_costos_operaciones (\n    grupo_operacion VARCHAR(100) PRIMARY KEY,\n    cantidad_operaciones INT NOT NULL,\n    costo_promedio DECIMAL(12,2) NULL\n);\n\nCREATE TABLE dbo.rep_operaciones_por_mes (\n    mes_del_anio INT PRIMARY KEY,\n    total_operaciones INT NOT NULL,\n    presupuesto_ejecutado DECIMAL(15,2) NULL\n);\n\nCREATE TABLE dbo.rep_rotacion_unidades (\n    nombre_unidad VARCHAR(150) PRIMARY KEY,\n    total_rotacion INT NOT NULL\n);"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
